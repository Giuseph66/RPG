// Firestore Security Rules — CLOUD-001 / ADR-0007.
// O cliente só acessa dados da própria conta e campanhas de que é membro.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function campaignExists(id) {
      return exists(/databases/$(database)/documents/campaigns/$(id));
    }
    function campaignOwner(id) {
      return signedIn() && campaignExists(id) &&
        get(/databases/$(database)/documents/campaigns/$(id)).data.ownerUid == request.auth.uid;
    }
    function memberExists(id, uid) {
      return exists(/databases/$(database)/documents/campaigns/$(id)/members/$(uid));
    }
    function activeMember(id, uid) {
      return memberExists(id, uid) &&
        get(/databases/$(database)/documents/campaigns/$(id)/members/$(uid)).data.status == 'active';
    }
    function campaignMember(id) {
      return signedIn() && (campaignOwner(id) || activeMember(id, request.auth.uid));
    }
    function protectedFieldsUnchanged(before, after) {
      return before.ownerUid == after.ownerUid && before.createdAt == after.createdAt;
    }
    function revisionAdvances(before, after) {
      return ('revision' in before) && ('revision' in after) && after.revision > before.revision;
    }
    function hasIdentity(data) {
      return data.ownerUid is string && data.createdAt is timestamp &&
        data.revision is int && data.schemaVersion is int;
    }
    function hasRecordIdentity(data, id) {
      return hasIdentity(data) && data.id is string && data.id == id;
    }
    function hasCampaignRecordIdentity(data, campaignId, id) {
      return hasRecordIdentity(data, id) && data.campaignId is string &&
        data.campaignId == campaignId;
    }
    function assetPathMatches(data, assetId) {
      return data.storagePath is string &&
        (('campaignId' in data) && data.campaignId is string
          ? data.storagePath == 'campaigns/' + data.campaignId + '/assets/' + assetId
          : !('campaignId' in data) && data.storagePath == 'users/' + data.ownerUid + '/assets/' + assetId);
    }
    function mapVisible(data) {
      return request.auth.uid in data.visibleTo || '*' in data.visibleTo;
    }
    function assetImmutableFieldsUnchanged(before, after) {
      return before.id == after.id && before.ownerUid == after.ownerUid &&
        before.createdAt == after.createdAt && before.hash == after.hash &&
        before.storagePath == after.storagePath &&
        (('campaignId' in before) == ('campaignId' in after)) &&
        (!('campaignId' in before) || before.campaignId == after.campaignId);
    }

    match /users/{uid} {
      allow read: if self(uid);
      allow create: if self(uid) && request.resource.data.uid == uid;
      allow update: if self(uid) && resource.data.uid == uid &&
        request.resource.data.uid == uid && request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /characters/{characterId} {
        allow get: if self(uid) && (resource == null ||
          (resource.data.ownerUid == uid && hasRecordIdentity(resource.data, characterId)));
        allow list: if self(uid);
        allow create: if self(uid) && hasRecordIdentity(request.resource.data, characterId) &&
          request.resource.data.ownerUid == uid;
        allow update: if self(uid) && hasRecordIdentity(resource.data, characterId) &&
          hasRecordIdentity(request.resource.data, characterId) && resource.data.ownerUid == uid &&
          protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data);
        allow delete: if self(uid) && resource.data.ownerUid == uid &&
          hasRecordIdentity(resource.data, characterId);
      }

      // Retratos privados novos usam o namespace da conta. Os registros legados
      // da coleção raiz seguem as regras de posse do caminho compatível.
      match /portraits/{portraitId} {
        function validPrivatePortrait(data) {
          return hasRecordIdentity(data, portraitId) && data.ownerUid == uid &&
            data.keys().hasOnly(['id', 'ownerUid', 'mediaType', 'sha256', 'width', 'height', 'data', 'createdAt', 'updatedAt', 'revision', 'schemaVersion', 'operationId']) &&
            data.data is string && data.data.size() > 0 && data.data.size() <= 900000 &&
            data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$') &&
            data.mediaType in ['image/webp', 'image/jpeg'] &&
            (!('width' in data) || (data.width is int && data.width > 0 && data.width <= 1024)) &&
            (!('height' in data) || (data.height is int && data.height > 0 && data.height <= 1024));
        }
        allow get: if self(uid) && (resource == null || resource.data.ownerUid == uid && resource.data.id == portraitId);
        allow list: if false;
        allow create: if self(uid) && validPrivatePortrait(request.resource.data);
        allow update: if self(uid) && resource.data.ownerUid == uid &&
          validPrivatePortrait(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'operationId', 'revision']) &&
          revisionAdvances(resource.data, request.resource.data);
        allow delete: if self(uid) && resource.data.ownerUid == uid;
      }
    }

    // A sincronização descobre os convites e campanhas consultando o grupo
    // `members` por accountId. A regra aninhada usa o ID do documento e não
    // consegue provar essa consulta de grupo; autorize apenas a lista filtrada
    // para a própria conta. As regras específicas abaixo continuam controlando
    // leituras e escritas pontuais de cada vínculo.
    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.accountId == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      function acceptedInviteLink(data) {
        return signedIn() && data.inviteLinkId is string &&
          existsAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)) &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)).data.campaignId == campaignId &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)).data.ownerUid == data.ownerUid &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)).data.status == 'accepted' &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)).data.acceptedBy == request.auth.uid &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)).data.acceptedAt == request.time &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)).data.expiresAt is timestamp &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inviteLinks/$(data.inviteLinkId)).data.expiresAt > request.time &&
          data.campaignId == campaignId && data.accountId == request.auth.uid &&
          data.ownerUid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid &&
          data.invitedBy == data.ownerUid && data.role == 'player' && data.status == 'active';
      }

      allow read: if (signedIn() && resource == null) ||
        (campaignMember(campaignId) && resource.data.id == campaignId);
      allow create: if signedIn() && hasRecordIdentity(request.resource.data, campaignId) &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if campaignOwner(campaignId) && resource.data.id == campaignId &&
        request.resource.data.id == campaignId && protectedFieldsUnchanged(resource.data, request.resource.data) &&
        revisionAdvances(resource.data, request.resource.data);
      allow delete: if campaignOwner(campaignId) && resource.data.id == campaignId;

      // Link de convite é uma capacidade aleatória, curta e de uso único. Não pode ser enumerado.
      match /inviteLinks/{tokenHash} {
        allow get: if signedIn() && (resource == null || resource.data.campaignId == campaignId);
        allow list: if false;
        allow create: if campaignOwner(campaignId) &&
          tokenHash.matches('^[a-f0-9]{64}$') &&
          request.resource.data.keys().hasOnly(['campaignId', 'ownerUid', 'status', 'createdAt', 'expiresAt']) &&
          request.resource.data.campaignId == campaignId &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.status == 'open' &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt > request.time;
        allow update: if (campaignOwner(campaignId) &&
          resource.data.campaignId == campaignId && resource.data.ownerUid == request.auth.uid && resource.data.status == 'open' &&
          request.resource.data.campaignId == campaignId && request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.expiresAt == resource.data.expiresAt &&
          request.resource.data.status == 'revoked' && request.resource.data.revokedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])) ||
          (signedIn() &&
          resource.data.campaignId == campaignId && resource.data.status == 'open' &&
          request.resource.data.campaignId == campaignId &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.expiresAt == resource.data.expiresAt &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedBy == request.auth.uid &&
          request.resource.data.acceptedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']) &&
          existsAfter(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)).data.inviteLinkId == tokenHash);
        allow delete: if false;
      }

      match /members/{memberUid} {
        allow get: if campaignOwner(campaignId) || self(memberUid);
        allow list: if campaignOwner(campaignId);
        // O proprietário também materializa seu vínculo de mestre. Nenhuma outra
        // conta pode criar um segundo mestre ou alterar a identidade do vínculo.
        allow create: if campaignOwner(campaignId) &&
          request.resource.data.campaignId == campaignId &&
          request.resource.data.accountId == memberUid &&
          request.resource.data.ownerUid == request.auth.uid &&
           ((request.resource.data.role == 'master' && memberUid == request.auth.uid &&
            request.resource.data.status == 'active' && request.resource.data.invitedBy == request.auth.uid) ||
           (request.resource.data.role == 'player' && request.resource.data.status == 'invited' &&
            request.resource.data.invitedBy == request.auth.uid &&
            request.resource.data.inviteExpiresAt is timestamp &&
            request.resource.data.inviteExpiresAt > request.time)) ||
          (self(memberUid) &&
            request.resource.data.campaignId == campaignId &&
            request.resource.data.accountId == memberUid &&
            request.resource.data.role == 'player' &&
            request.resource.data.status == 'active' &&
            acceptedInviteLink(request.resource.data));
        // O mestre pode revogar/manter um jogador. O convidado só aceita o próprio convite.
        allow update: if (campaignOwner(campaignId) && request.resource.data.role == 'player' &&
          resource.data.campaignId == campaignId && resource.data.accountId == memberUid &&
          request.resource.data.campaignId == campaignId &&
          request.resource.data.accountId == memberUid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.invitedBy == resource.data.invitedBy &&
          request.resource.data.status in ['invited', 'active', 'revoked'] &&
          (request.resource.data.status != 'invited' ||
            (request.resource.data.inviteExpiresAt is timestamp && request.resource.data.inviteExpiresAt > request.time)) &&
          revisionAdvances(resource.data, request.resource.data)) ||
          (self(memberUid) && resource.data.status == 'invited' && resource.data.role == 'player' &&
            request.resource.data.status == 'active' && request.resource.data.role == 'player' &&
            resource.data.campaignId == campaignId && resource.data.accountId == memberUid &&
            request.resource.data.campaignId == campaignId &&
            request.resource.data.accountId == memberUid &&
            request.resource.data.ownerUid == resource.data.ownerUid &&
            request.resource.data.invitedBy == resource.data.invitedBy &&
            resource.data.inviteExpiresAt is timestamp &&
            resource.data.inviteExpiresAt > request.time &&
            request.resource.data.inviteExpiresAt == resource.data.inviteExpiresAt &&
            revisionAdvances(resource.data, request.resource.data)) ||
          (self(memberUid) && resource.data.role == 'player' &&
            resource.data.status in ['invited', 'active', 'revoked'] &&
            resource.data.campaignId == campaignId && resource.data.accountId == memberUid &&
            request.resource.data.campaignId == campaignId &&
            request.resource.data.accountId == memberUid &&
            request.resource.data.ownerUid == resource.data.ownerUid &&
            request.resource.data.invitedBy == resource.data.invitedBy &&
            request.resource.data.role == 'player' && request.resource.data.status == 'active' &&
            revisionAdvances(resource.data, request.resource.data) &&
            acceptedInviteLink(request.resource.data));
        allow delete: if campaignOwner(campaignId) && resource.data.campaignId == campaignId &&
          resource.data.accountId == memberUid && resource.data.role == 'player';
      }

      match /characters/{characterId} {
        allow get: if campaignMember(campaignId) && (resource == null || hasCampaignRecordIdentity(resource.data, campaignId, characterId));
        allow list: if campaignMember(campaignId);
        allow create: if activeMember(campaignId, request.auth.uid) &&
          hasCampaignRecordIdentity(request.resource.data, campaignId, characterId) &&
          request.resource.data.ownerUid == request.auth.uid;
        allow update: if campaignMember(campaignId) &&
          hasCampaignRecordIdentity(resource.data, campaignId, characterId) &&
          hasCampaignRecordIdentity(request.resource.data, campaignId, characterId) &&
          protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data) &&
          // O dono edita a ficha inteira; o mestre só ajusta PV, condições e ajustes manuais.
          (resource.data.ownerUid == request.auth.uid ||
            (campaignOwner(campaignId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'conditions', 'manualAdjustments', 'updatedAt', 'revision', 'operationId'])));
        allow delete: if campaignMember(campaignId) &&
          hasCampaignRecordIdentity(resource.data, campaignId, characterId) &&
          resource.data.ownerUid == request.auth.uid;
      }

      // Histórico da mesa: rolagens e mudanças de PV/condições. Todos os membros leem; cada
      // um só escreve em nome da própria conta; ninguém reescreve; o mestre pode limpar.
      match /log/{entryId} {
        allow get, list: if campaignMember(campaignId);
        allow create: if campaignMember(campaignId) &&
          request.resource.data.keys().hasOnly(['id', 'campaignId', 'characterId', 'characterName', 'actorUid', 'byMaster', 'kind', 'summary', 'detail', 'rollPurpose', 'rollTotal', 'createdAt', 'at']) &&
          request.resource.data.id == entryId && request.resource.data.campaignId == campaignId &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.kind in ['roll', 'hit-points', 'conditions', 'adjustments'] &&
          request.resource.data.byMaster is bool &&
          request.resource.data.characterId is string && request.resource.data.characterId.size() <= 64 &&
          request.resource.data.characterName is string && request.resource.data.characterName.size() <= 120 &&
          request.resource.data.summary is string && request.resource.data.summary.size() <= 200 &&
          (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 300)) &&
          (!('rollPurpose' in request.resource.data) || request.resource.data.rollPurpose is string) &&
          (!('rollTotal' in request.resource.data) || request.resource.data.rollTotal is number) &&
          request.resource.data.createdAt is string && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if campaignOwner(campaignId);
      }

      // Cópia do retrato do personagem para a campanha: o mestre e o grupo veem a imagem do jogador.
      match /portraits/{portraitId} {
        function validCampaignPortrait(data) {
          return hasCampaignRecordIdentity(data, campaignId, portraitId) && data.ownerUid == request.auth.uid &&
            data.keys().hasOnly(['id', 'ownerUid', 'campaignId', 'mediaType', 'sha256', 'width', 'height', 'data', 'createdAt', 'updatedAt', 'revision', 'schemaVersion', 'operationId']) &&
            data.data is string && data.data.size() > 0 && data.data.size() <= 900000 &&
            data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$') &&
            data.mediaType in ['image/webp', 'image/jpeg'] &&
            (!('width' in data) || (data.width is int && data.width > 0 && data.width <= 1024)) &&
            (!('height' in data) || (data.height is int && data.height > 0 && data.height <= 1024));
        }
        allow get: if campaignMember(campaignId);
        allow list: if false;
        allow create: if campaignMember(campaignId) && validCampaignPortrait(request.resource.data);
        allow update: if campaignMember(campaignId) && resource.data.ownerUid == request.auth.uid &&
          validCampaignPortrait(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'operationId', 'revision']) &&
          revisionAdvances(resource.data, request.resource.data);
        allow delete: if campaignMember(campaignId) && resource.data.ownerUid == request.auth.uid;
      }

      // Cada conta tem o próprio diário. O mestre lê todos; um jogador só lê o seu.
      match /journals/{journalId} {
        allow get: if campaignMember(campaignId) && (resource == null ||
          (hasCampaignRecordIdentity(resource.data, campaignId, journalId) &&
            (campaignOwner(campaignId) || resource.data.ownerUid == request.auth.uid)));
        allow list: if campaignOwner(campaignId) ||
          (activeMember(campaignId, request.auth.uid) && resource.data.ownerUid == request.auth.uid);
        allow create: if activeMember(campaignId, request.auth.uid) &&
          hasCampaignRecordIdentity(request.resource.data, campaignId, journalId) &&
          request.resource.data.ownerUid == request.auth.uid;
        allow update: if campaignMember(campaignId) &&
          hasCampaignRecordIdentity(resource.data, campaignId, journalId) &&
          hasCampaignRecordIdentity(request.resource.data, campaignId, journalId) &&
          resource.data.ownerUid == request.auth.uid &&
          protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data);
        allow delete: if campaignMember(campaignId) &&
          hasCampaignRecordIdentity(resource.data, campaignId, journalId) &&
          (resource.data.ownerUid == request.auth.uid || campaignOwner(campaignId));
      }

      // Mapas começam privados do mestre; `visibleTo` libera contas específicas ou '*'.
      match /maps/{mapId} {
        allow get: if (campaignOwner(campaignId) && (resource == null || hasCampaignRecordIdentity(resource.data, campaignId, mapId))) ||
          (activeMember(campaignId, request.auth.uid) && resource != null &&
            hasCampaignRecordIdentity(resource.data, campaignId, mapId) && mapVisible(resource.data));
        allow list: if campaignOwner(campaignId) ||
          (activeMember(campaignId, request.auth.uid) && mapVisible(resource.data));
        allow create: if campaignOwner(campaignId) &&
          hasCampaignRecordIdentity(request.resource.data, campaignId, mapId) &&
          request.resource.data.ownerUid == request.auth.uid;
        allow update: if campaignOwner(campaignId) &&
          hasCampaignRecordIdentity(resource.data, campaignId, mapId) &&
          hasCampaignRecordIdentity(request.resource.data, campaignId, mapId) &&
          protectedFieldsUnchanged(resource.data, request.resource.data) &&
          revisionAdvances(resource.data, request.resource.data);
        allow delete: if campaignOwner(campaignId) && hasCampaignRecordIdentity(resource.data, campaignId, mapId);

        // Imagem base64 do mapa: o mestre prepara uma versão em estado staged,
        // grava os chunks e só então pode marcá-la completa. O mapa precisa
        // apontar para a versão completa antes que um jogador possa lê-la.
        match /content/{contentSha256} {
          function contentPath() {
            return 'campaigns/' + campaignId + '/maps/' + mapId + '/content/' + contentSha256;
          }

          function validContentDigest(value) {
            return value is string && value.matches('^[a-f0-9]{64}$') && value == contentSha256;
          }

          function validContentManifest(data) {
            return data.keys().hasOnly(['schemaVersion', 'kind', 'campaignId', 'mapId', 'ownerUid', 'sha256', 'mediaType', 'size', 'chunkSize', 'chunkCount', 'complete']) &&
              data.schemaVersion == 1 && data.kind == 'map-image' &&
              data.campaignId == campaignId && data.mapId == mapId &&
              data.ownerUid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid &&
              validContentDigest(data.sha256) &&
              data.mediaType in ['image/png', 'image/jpeg', 'image/webp'] &&
              data.size is int && data.size > 0 && data.size <= 10485760 &&
              data.chunkSize == 655360 &&
              data.chunkCount is int && data.chunkCount > 0 && data.chunkCount <= 16 &&
              data.size > (data.chunkCount - 1) * data.chunkSize &&
              data.size <= data.chunkCount * data.chunkSize &&
              data.complete is bool;
          }

          function mapReferencesContent() {
            return get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)).data.image is map &&
              get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)).data.image.storagePath == contentPath() &&
              get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)).data.image.sha256 == contentSha256;
          }

          function mapIsVisibleToCaller() {
            return get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)).data.visibleTo is list &&
              (request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)).data.visibleTo ||
                '*' in get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)).data.visibleTo);
          }

          function playerCanReadManifest() {
            return signedIn() && activeMember(campaignId, request.auth.uid) && resource != null &&
              validContentManifest(resource.data) && resource.data.complete == true &&
              mapReferencesContent() && mapIsVisibleToCaller();
          }

          allow get: if campaignOwner(campaignId) || playerCanReadManifest();
          allow list: if campaignOwner(campaignId);
          allow create: if campaignOwner(campaignId) &&
            validContentManifest(request.resource.data) && request.resource.data.ownerUid == request.auth.uid &&
            request.resource.data.complete == false;
          allow update: if campaignOwner(campaignId) &&
            resource != null && validContentManifest(resource.data) && validContentManifest(request.resource.data) &&
            resource.data.ownerUid == request.auth.uid && resource.data.complete == false &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']);
          allow delete: if campaignOwner(campaignId) && resource != null &&
            validContentManifest(resource.data) && resource.data.ownerUid == request.auth.uid;

          match /chunks/{chunkIndex} {
            function canonicalChunkIndex(data) {
              return (chunkIndex == '0' && data.index == 0) ||
                (chunkIndex == '1' && data.index == 1) ||
                (chunkIndex == '2' && data.index == 2) ||
                (chunkIndex == '3' && data.index == 3) ||
                (chunkIndex == '4' && data.index == 4) ||
                (chunkIndex == '5' && data.index == 5) ||
                (chunkIndex == '6' && data.index == 6) ||
                (chunkIndex == '7' && data.index == 7) ||
                (chunkIndex == '8' && data.index == 8) ||
                (chunkIndex == '9' && data.index == 9) ||
                (chunkIndex == '10' && data.index == 10) ||
                (chunkIndex == '11' && data.index == 11) ||
                (chunkIndex == '12' && data.index == 12) ||
                (chunkIndex == '13' && data.index == 13) ||
                (chunkIndex == '14' && data.index == 14) ||
                (chunkIndex == '15' && data.index == 15);
            }

            function expectedChunkSize(data, manifest) {
              return (data.index < manifest.chunkCount - 1 && data.size == manifest.chunkSize) ||
                (data.index == manifest.chunkCount - 1 &&
                  ((manifest.size % manifest.chunkSize == 0 && data.size == manifest.chunkSize) ||
                    (manifest.size % manifest.chunkSize != 0 && data.size == manifest.size % manifest.chunkSize)));
            }

            function validContentChunk(data, manifest) {
              return data.keys().hasOnly(['schemaVersion', 'index', 'chunkCount', 'size', 'sha256', 'data']) &&
                data.schemaVersion == 1 && data.index is int && data.index >= 0 && data.index <= 15 &&
                canonicalChunkIndex(data) && data.chunkCount == manifest.chunkCount && data.index < manifest.chunkCount &&
                data.size is int && data.size > 0 && data.size <= manifest.chunkSize && expectedChunkSize(data, manifest) &&
                data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$') &&
                data.data is string && data.data.size() > 0 && data.data.size() <= 873816 &&
                data.data.matches('^[A-Za-z0-9+/]*={0,2}$');
            }

            function playerCanReadChunk() {
              return signedIn() && activeMember(campaignId, request.auth.uid) && resource != null &&
                get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data.complete == true &&
                validContentManifest(get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data) &&
                validContentChunk(resource.data, get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data) &&
                mapReferencesContent() && mapIsVisibleToCaller();
            }

            allow get: if campaignOwner(campaignId) || playerCanReadChunk();
            allow list: if campaignOwner(campaignId);
            allow create: if campaignOwner(campaignId) &&
              validContentManifest(get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data) &&
              get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data.complete == false &&
              validContentChunk(request.resource.data, get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data);
            allow update: if campaignOwner(campaignId) &&
              validContentManifest(get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data) &&
              resource != null && validContentChunk(resource.data, get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data) &&
              validContentChunk(request.resource.data, get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([]);
            allow delete: if campaignOwner(campaignId) &&
              resource != null && validContentChunk(resource.data, get(/databases/$(database)/documents/campaigns/$(campaignId)/maps/$(mapId)/content/$(contentSha256)).data);
          }
        }
      }

      // Registro completo de criaturas: exclusivo do mestre.
      match /creatures/{creatureId} {
        // A identidade do documento pode ser validada em uma leitura pontual;
        // uma lista autorizada pelo mestre precisa ser expressa separadamente,
        // pois `resource` não representa todos os documentos da consulta.
        allow get: if campaignOwner(campaignId) && (resource == null || hasCampaignRecordIdentity(resource.data, campaignId, creatureId));
        allow list: if campaignOwner(campaignId);
        allow create: if campaignOwner(campaignId) && hasCampaignRecordIdentity(request.resource.data, campaignId, creatureId) &&
          request.resource.data.ownerUid == request.auth.uid;
        allow update: if campaignOwner(campaignId) && hasCampaignRecordIdentity(resource.data, campaignId, creatureId) &&
          hasCampaignRecordIdentity(request.resource.data, campaignId, creatureId) &&
          protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data);
        allow delete: if campaignOwner(campaignId) && hasCampaignRecordIdentity(resource.data, campaignId, creatureId);
      }

      // O que o mestre revelou de uma criatura para uma conta. O jogador só lê o próprio.
      match /sightings/{sightingId} {
        function sightingShape(data) {
          return hasCampaignRecordIdentity(data, campaignId, sightingId) &&
            data.accountId is string && data.creatureId is string &&
            sightingId == data.creatureId + '__' + data.accountId &&
            !('notes' in data.revealed) && !('reveals' in data);
        }
        allow get: if campaignMember(campaignId) && (resource == null ||
          (hasCampaignRecordIdentity(resource.data, campaignId, sightingId) &&
            (campaignOwner(campaignId) || resource.data.accountId == request.auth.uid)));
        allow list: if campaignOwner(campaignId) ||
          (activeMember(campaignId, request.auth.uid) && resource.data.accountId == request.auth.uid);
        allow create: if campaignOwner(campaignId) && sightingShape(request.resource.data) &&
          request.resource.data.ownerUid == request.auth.uid;
        allow update: if campaignOwner(campaignId) && sightingShape(resource.data) && sightingShape(request.resource.data) &&
          request.resource.data.accountId == resource.data.accountId &&
          protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data);
        allow delete: if campaignOwner(campaignId) && hasCampaignRecordIdentity(resource.data, campaignId, sightingId);
      }

      // Palpite de um jogador sobre uma criatura avistada; o mestre lê todos.
      match /guesses/{guessId} {
        function guessShape(data) {
          return hasCampaignRecordIdentity(data, campaignId, guessId) &&
            data.accountId is string && data.creatureId is string &&
            guessId == data.creatureId + '__' + data.accountId &&
            data.name is string && data.name.size() <= 80 && data.note is string && data.note.size() <= 800 &&
            (!('fields' in data) || (data.fields is map &&
              data.fields.keys().hasOnly(['appearance', 'race', 'hitPoints', 'armorClass', 'abilities'])));
        }
        allow get: if campaignMember(campaignId) && (resource == null ||
          (hasCampaignRecordIdentity(resource.data, campaignId, guessId) &&
            (campaignOwner(campaignId) || resource.data.accountId == request.auth.uid)));
        allow list: if campaignOwner(campaignId) ||
          (activeMember(campaignId, request.auth.uid) && resource.data.accountId == request.auth.uid);
        allow create: if activeMember(campaignId, request.auth.uid) && guessShape(request.resource.data) &&
          request.resource.data.accountId == request.auth.uid && request.resource.data.ownerUid == request.auth.uid &&
          exists(/databases/$(database)/documents/campaigns/$(campaignId)/sightings/$(guessId));
        allow update: if activeMember(campaignId, request.auth.uid) && guessShape(resource.data) && guessShape(request.resource.data) &&
          resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid &&
          protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data);
        allow delete: if hasCampaignRecordIdentity(resource.data, campaignId, guessId) &&
          (campaignOwner(campaignId) || (activeMember(campaignId, request.auth.uid) && resource.data.accountId == request.auth.uid));
      }

      match /sessions/{sessionId} {
        // Session notes and attendance are campaign data. Active members can
        // read them; only the campaign master can mutate them.
        allow get: if campaignMember(campaignId) && (resource == null || hasCampaignRecordIdentity(resource.data, campaignId, sessionId));
        allow list: if campaignMember(campaignId);
        allow create: if campaignOwner(campaignId) && hasIdentity(request.resource.data) &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.campaignId == campaignId && request.resource.data.id == sessionId;
        allow update: if campaignOwner(campaignId) && resource.data.ownerUid == request.auth.uid &&
          request.resource.data.campaignId == resource.data.campaignId &&
          request.resource.data.id == resource.data.id &&
          protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data);
        allow delete: if campaignOwner(campaignId) && resource.data.ownerUid == request.auth.uid &&
          hasCampaignRecordIdentity(resource.data, campaignId, sessionId);
      }
    }

    match /assets/{assetId} {
      allow read: if signedIn() && (resource == null ||
        (resource.data.id == assetId && assetPathMatches(resource.data, assetId) &&
          (resource.data.ownerUid == request.auth.uid ||
            (resource.data.campaignId is string && campaignMember(resource.data.campaignId)))));
      allow create: if signedIn() && hasIdentity(request.resource.data) &&
        request.resource.data.id == assetId && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.hash is string && assetPathMatches(request.resource.data, assetId) &&
        (!('campaignId' in request.resource.data) || campaignMember(request.resource.data.campaignId));
      allow update: if signedIn() && hasIdentity(resource.data) && hasIdentity(request.resource.data) &&
        resource.data.id == assetId && request.resource.data.id == assetId &&
        resource.data.ownerUid == request.auth.uid && assetPathMatches(resource.data, assetId) &&
        assetPathMatches(request.resource.data, assetId) && assetImmutableFieldsUnchanged(resource.data, request.resource.data) &&
        protectedFieldsUnchanged(resource.data, request.resource.data) && revisionAdvances(resource.data, request.resource.data) &&
        (!('campaignId' in request.resource.data) || campaignMember(request.resource.data.campaignId));
      allow delete: if signedIn() && resource.data.id == assetId && resource.data.ownerUid == request.auth.uid;
    }

    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.accountId == request.auth.uid;
    }

    match /portraits/{portraitId} {
      function validPortrait(data) {
        return hasRecordIdentity(data, portraitId) && data.ownerUid == request.auth.uid &&
          data.keys().hasOnly(['id', 'ownerUid', 'mediaType', 'sha256', 'width', 'height', 'data', 'createdAt', 'updatedAt', 'revision', 'schemaVersion', 'operationId']) &&
          data.data is string && data.data.size() > 0 && data.data.size() <= 900000 &&
          data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$') &&
          data.mediaType in ['image/webp', 'image/jpeg'] &&
          (!('width' in data) || (data.width is int && data.width > 0 && data.width <= 1024)) &&
          (!('height' in data) || (data.height is int && data.height > 0 && data.height <= 1024));
      }
      allow get: if signedIn() && (resource == null ||
        (resource.data.ownerUid == request.auth.uid && resource.data.id == portraitId));
      allow list: if false;
      allow create: if signedIn() && validPortrait(request.resource.data);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid &&
        validPortrait(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'operationId', 'revision']) &&
        (revisionAdvances(resource.data, request.resource.data) ||
          (!('revision' in resource.data) && request.resource.data.revision == 1));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
