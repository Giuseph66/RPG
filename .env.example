# Firebase client configuration (optional; never place service-account secrets here).
# These are public client identifiers, not secrets — safe to ship in the bundle per Firebase docs.
# Unprefixed names (apiKey, authDomain, projectId, storageBucket, messagingSenderId,
# appId, measurementId) are also accepted at build time as a fallback; VITE_FIREBASE_*
# takes precedence when both are set. See vite.config.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
